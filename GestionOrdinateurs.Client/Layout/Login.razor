@page "/login"
@using Blazored.SessionStorage
@inject HttpClient Http
@inject ISessionStorageService SessionStorage
@inject NavigationManager Navigation

<h3>Connexion</h3>

<div class="row col-md-6">
    <div class="mb-3">
        <label class="form-label">Identifiant (Login) :</label>
        <input type="text" class="form-control" @bind="loginInput" placeholder="Ex: user1" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <button class="btn btn-primary" @onclick="SeConnecter">Connexion</button>
</div>

@code {
    private string loginInput = string.Empty;
    private string errorMessage = string.Empty;

    private async Task SeConnecter()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(loginInput))
        {
            errorMessage = "Veuillez saisir un login.";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/Authentication/login", loginInput);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<TokenResponse>();
                if (result != null && !string.IsNullOrEmpty(result.Token))
                {
                    // Sauvegarde du Token JWT dans la session Blazor
                    await SessionStorage.SetItemAsync("authToken", result.Token);

                    // Redirection vers l'accueil
                    Navigation.NavigateTo("/");
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                errorMessage = "Il n'existe pas.";
            }
            else
            {
                errorMessage = "Erreur lors de la connexion.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur : {ex.Message}";
        }
    }

    public class TokenResponse
    {
        public string Token { get; set; } = string.Empty;
    }
}