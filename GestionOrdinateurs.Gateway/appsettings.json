{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "route-ordinateurs": {
        "ClusterId": "backend-api",
        "Match": {
          "Path": "/api/ordinateur/{**catch-all}"
        }
      },
      "route-reparations": {
        "ClusterId": "backend-api",
        "Match": {
          "Path": "/api/reparation/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "backend-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5130/"
          }
        }
      }
    }
  }
}